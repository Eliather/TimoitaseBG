/* 
  TimoitaseBG - Hoja de estilos principal (Dark Theme Nativo) 
  Aplicado a la capa superior de PySide6 para uniformidad estética 
*/

/* --- FONDO GLOBAL Y TEXTO --- */
QWidget {
    background-color: #121212;
    color: #E0E0E0;
    font-family: 'Segoe UI', 'San Francisco', 'Inter', sans-serif;
    font-size: 13px;
}

/* --- BARRA LATERAL (TOOLBAR) --- */
QWidget#toolSidebar, QWidget#sidebar {
    background-color: #1A1A1A;
    border-left: 1px solid #2A2A2A;
}

QWidget#sidebar_header, QWidget#tool_tabs_row, QWidget#quick_shortcuts_box, QWidget#scroll_content, QWidget#toolsStack {
    background-color: transparent;
}

QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

QLabel#sidebarHeader {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    background: transparent;
}

QLabel#sidebarSubheader {
    font-size: 12px;
    color: #888888;
    background: transparent;
}

/* --- BOTONES PRINCIPALES --- */
QPushButton {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3D3D3D;
    border: 1px solid #4D4D4D;
}

QPushButton:pressed {
    background-color: #555555;
}

QPushButton:checked {
    background-color: #FF4F79; /* Rosa Sakura activo */
    color: #FFFFFF;
    border: 1px solid #FF3B6B;
}

QPushButton:disabled {
    background-color: #1E1E1E;
    color: #555555;
    border: 1px solid #222222;
}

/* --- BOTÓN DE ACCIÓN DESTACADO (Call to Action) --- */
QPushButton#actionButton {
    background-color: #FF4F79;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
}
QPushButton#actionButton:hover {
    background-color: #FF3B6B;
}
QPushButton#actionButton:disabled {
    background-color: #4A1A27;
    color: #888888;
}

/* --- BOTONES DE HERRAMIENTA Y ZOOM --- */
QPushButton#toolRailButton {
    padding: 6px 2px;
    font-size: 12px;
}
QPushButton#compactIconButton, QPushButton#zoomButton {
    padding: 4px;
    font-size: 14px;
}

/* --- SWATCHES Y PRESETS --- */
QPushButton#presetButton {
    padding: 2px 4px;
    font-size: 11px;
}
QPushButton#brushToolModeButton {
    padding: 4px 8px;
}
QPushButton#selectionModeButton {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    padding: 2px 8px;
}
QPushButton#selectionModeButton:hover {
    background-color: #3D3D3D;
    border-color: #555555;
    color: #FFFFFF;
}
QPushButton#selectionModeButton:checked {
    background-color: #2563EB;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}

QPushButton#dangerActionButton {
    background-color: #DC2626;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton#dangerActionButton:hover {
    background-color: #EF4444;
}
QPushButton#dangerActionButton:pressed {
    background-color: #B91C1C;
}
QPushButton#dangerActionButton:disabled {
    background-color: #3D1C24;
    color: #77555E;
    border: 1px solid #4D222E;
}

QPushButton#swatchWhiteButton { background-color: #FFFFFF; border: 1px solid #D6D3D1; padding: 0px; }
QPushButton#swatchBlackButton { background-color: #000000; border: 1px solid #3D3D3D; padding: 0px; }
QPushButton#swatchGrayButton { background-color: #E2E8F0; border: 1px solid #D6D3D1; padding: 0px; }
QPushButton#swatchNoneButton, QPushButton#swatchCustomButton { padding: 0px; }

QPushButton#swatchWhiteButton:checked, QPushButton#swatchBlackButton:checked, QPushButton#swatchGrayButton:checked, QPushButton#swatchCustomButton:checked, QPushButton#swatchNoneButton:checked {
    border: 2px solid #FF4F79;
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    border: 1px solid #333333;
    height: 6px;
    background: #2D2D2D;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #FF4F79;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #777777;
    width: 14px;
    height: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #EEEEEE;
    border: 1px solid #FF4F79;
}

/* --- COMBOBOX / SELECTORS --- */
QComboBox {
    background-color: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    padding: 5px 28px 5px 10px;
    color: #FFFFFF;
    font-size: 12px;
}
QComboBox:hover {
    border: 1px solid #FF4F79;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url({ASSETS_PATH}/chevron-down-dark.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox::down-arrow:hover {
    image: url({ASSETS_PATH}/chevron-down-hover.svg);
}
QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    selection-background-color: #FF4F79;
    color: white;
    padding: 4px;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: #121212;
    width: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #555555;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- TABS --- */
QTabWidget::pane {
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background: #1A1A1A;
    color: #888888;
    border: 1px solid #2A2A2A;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #2D2D2D;
    color: #FFFFFF;
    border-bottom-color: #2D2D2D;
}
QTabBar::tab:hover:!selected {
    background: #252525;
    color: #DDDDDD;
}

/* --- CHECKBOXES --- */
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #555555;
    border-radius: 4px;
    background: #1E1E1E;
}
QCheckBox::indicator:checked {
    background: #FF4F79;
    border: 1px solid #FF3B6B;
}
QCheckBox::indicator:hover {
    border: 1px solid #FF4F79;
}

/* --- WINDOW CONTROLS (Frameless macOS style) --- */
#macMinBtn {
    background-color: #FFBD2E;
    border-radius: 7px;
}
#macMinBtn:hover {
    background-color: #FFC950;
}
#macMaxBtn {
    background-color: #28C940;
    border-radius: 7px;
}
#macMaxBtn:hover {
    background-color: #31DB4A;
}
#macCloseBtn {
    background-color: #FF5F56;
    border-radius: 7px;
}
#macCloseBtn:hover {
    background-color: #FF746D;
}

/* --- KO-FI BUTTON --- */
#kofiButton {
    background-color: #FF5E5B;
    color: white;
    font-weight: bold;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
}
#kofiButton:hover {
    background-color: #FF7775;
}

/* --- FRAMELESS POPUP --- */
#framelessPopupRoot {
    background-color: #1A1A1A;
    border-radius: 10px;
    border: 1px solid #333333;
}
#popupTitle {
    font-weight: bold;
    color: #8E8E8E;
}

/* --- GROUPBOXES Y ETIQUETAS DE SECCIÓN CON FONDO DETRÁS DEL TEXTO --- */
QGroupBox {
    background-color: #1E1E1E;
    border: 1px solid #2D2D2D;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 3px 10px;
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}

QGroupBox#wandOptionsBox::title {
    background-color: #3B1828;
    color: #FF4F79;
    border: 1px solid #5C1E3A;
}

QGroupBox#selectionBox::title {
    background-color: #1E293B;
    color: #60A5FA;
    border: 1px solid #334155;
}

/* --- SHORTCUTS MODAL DIALOG --- */
#shortcutsDialogRoot {
    background-color: #1E1E1E;
    border-radius: 12px;
    border: 1px solid #333333;
}
#shortcutsDialogTitle {
    font-size: 14px;
    font-weight: 700;
    color: #F3F4F6;
}
#shortcutsCategoryTitle {
    font-size: 11px;
    font-weight: 700;
    color: #FF4F79;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
}
#statusShortcutsButton {
    background-color: #262626;
    color: #9CA3AF;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
#statusShortcutsButton:hover {
    color: #FF4F79;
    border-color: #FF4F79;
    background-color: #2D2024;
}
#statusShortcutsButton:pressed {
    background-color: #38242A;
}
#shortcutBadge {
    background-color: #262626;
    color: #E5E7EB;
    border: 1px solid #404040;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
}
#shortcutDesc {
    color: #D1D5DB;
    font-size: 12px;
}

