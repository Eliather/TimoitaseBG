/* 
  TimoitaseBG - Hoja de estilos principal (Dark Theme Nativo - Coherente e Integral) 
*/

/* --- VENTANA PRINCIPAL Y FONDO GLOBAL --- */
QMainWindow, QDialog {
    background-color: #0F172A;
    color: #F8FAFC;
}
QWidget {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    font-size: 13px;
}
QLabel {
    background-color: transparent;
    color: #F8FAFC;
}
QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* --- TOOLTIPS --- */
QToolTip {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

/* --- BARRA SUPERIOR (TOP BAR) --- */
QFrame#TopBar, QWidget#TopBar, QWidget#topBar {
    background-color: #1E293B;
    border-bottom: 1px solid #334155;
}
QLabel#AppTitle, QLabel#appNameLabel {
    font-size: 15px;
    font-weight: 700;
    color: #F8FAFC;
    background: transparent;
}
QLabel#appVersionBadge {
    background-color: #334155;
    color: #CBD5E1;
    border: 1px solid #475569;
    padding: 2px 8px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#zoomLabel {
    font-weight: 600;
    color: #CBD5E1;
    padding: 0 4px;
    background: transparent;
}

/* --- BOTONES GENERALES --- */
QPushButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    color: #E2E8F0;
}
QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #475569;
}
QPushButton:checked {
    background-color: #3B1219;
    border: 1.5px solid #F43F5E;
    color: #FB7185;
}
QPushButton:disabled {
    background-color: #0F172A;
    border-color: #1E293B;
    color: #475569;
}

/* --- BOTÓN PRIMARIO (Coral / Rosa) --- */
QPushButton#PrimaryBtn, QPushButton#primaryBtn {
    background-color: #F43F5E;
    border: 1px solid #E11D48;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton#PrimaryBtn:hover, QPushButton#primaryBtn:hover {
    background-color: #E11D48;
    border-color: #BE123C;
}
QPushButton#PrimaryBtn:pressed, QPushButton#primaryBtn:pressed,
QPushButton#PrimaryBtn:checked, QPushButton#primaryBtn:checked {
    background-color: #BE123C;
    border: 1.5px solid #FDA4AF;
    color: #FFFFFF;
}
QPushButton#PrimaryBtn:disabled, QPushButton#primaryBtn:disabled {
    background-color: #2A121B;
    border-color: #3F1A26;
    color: #881337;
}

/* Compatibilidad actionButton */
QPushButton#actionButton {
    background-color: #F43F5E;
    border: 1px solid #E11D48;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton#actionButton:hover {
    background-color: #E11D48;
}
QPushButton#actionButton:pressed {
    background-color: #BE123C;
}
QPushButton#actionButton:disabled {
    background-color: #2A121B;
    border-color: #3F1A26;
    color: #881337;
}

/* --- BOTÓN DE ACCIÓN PRINCIPAL EN PANEL (Oscuro Coherente con Acento Coral) --- */
QPushButton#ActionBtn, QPushButton#primaryActionButton {
    background-color: #F43F5E;
    border: 1px solid #E11D48;
    color: #FFFFFF;
    padding: 10px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
}
QPushButton#ActionBtn:hover, QPushButton#primaryActionButton:hover {
    background-color: #E11D48;
    border-color: #FB7185;
}
QPushButton#ActionBtn:pressed, QPushButton#primaryActionButton:pressed {
    background-color: #BE123C;
}
QPushButton#ActionBtn:disabled, QPushButton#primaryActionButton:disabled {
    background-color: #1E293B;
    border: 1px solid #334155;
    color: #64748B;
}

/* --- PESTAÑAS DE HERRAMIENTAS Y BOTONES DE MODO --- */
QPushButton#ToolTab, QPushButton#toolRailButton {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 4px;
    font-weight: 600;
    font-size: 12px;
    color: #94A3B8;
}
QPushButton#ToolTab:hover, QPushButton#toolRailButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #F8FAFC;
}
QPushButton#ToolTab:checked, QPushButton#toolRailButton:checked {
    background-color: #3B1219;
    border: 1.5px solid #F43F5E;
    color: #FB7185;
}

QPushButton#brushToolModeButton, QPushButton#presetButton, QPushButton#selectionModeButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    color: #CBD5E1;
}
QPushButton#brushToolModeButton:hover, QPushButton#presetButton:hover, QPushButton#selectionModeButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #F8FAFC;
}
QPushButton#brushToolModeButton:checked, QPushButton#presetButton:checked, QPushButton#selectionModeButton:checked {
    background-color: #3B1219;
    border: 1.5px solid #F43F5E;
    color: #FB7185;
    font-weight: 700;
}
QPushButton#brushToolModeButton:disabled, QPushButton#presetButton:disabled, QPushButton#selectionModeButton:disabled {
    background-color: #0F172A;
    border-color: #1E293B;
    color: #475569;
}

/* --- PANEL LATERAL Y TARJETAS --- */
QFrame#SidePanel, QWidget#toolSidebar, QWidget#sidebar {
    background-color: #1E293B;
    border-left: 1px solid #334155;
}
QWidget#sidebar_header, QWidget#tool_tabs_row, QWidget#quick_shortcuts_box, QWidget#scroll_content, QWidget#toolsStack {
    background-color: transparent;
}
QFrame#Card, QGroupBox#Card {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 10px;
}
QLabel#SectionTitle, QLabel#sidebarHeader {
    font-size: 16px;
    font-weight: 700;
    color: #F8FAFC;
    background: transparent;
}
QLabel#SubTitle, QLabel#sidebarSubheader {
    font-size: 12px;
    color: #94A3B8;
    background: transparent;
}
QLabel#FieldLabel, QLabel#fieldLabel {
    font-weight: 600;
    color: #CBD5E1;
    font-size: 12px;
    background: transparent;
}
QLabel#toolInfoIcon {
    color: #94A3B8;
    font-size: 12px;
    background: transparent;
}
QLabel#toolInfoIcon:hover {
    color: #FB7185;
}
QLabel#brushSizeLabel, QLabel#colorHexLabel {
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

/* --- BOTONES DE ZOOM E HISTORIAL --- */
QPushButton#compactIconButton, QPushButton#zoomButton {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #E2E8F0;
}
QPushButton#compactIconButton:hover, QPushButton#zoomButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #FFFFFF;
}
QPushButton#compactIconButton:disabled, QPushButton#zoomButton:disabled {
    background-color: #0F172A;
    border-color: #1E293B;
    color: #475569;
}

QPushButton#secondaryActionButton {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
}
QPushButton#secondaryActionButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #FB7185;
}
QPushButton#secondaryActionButton:disabled {
    background-color: #0F172A;
    color: #475569;
    border-color: #1E293B;
}

/* --- SWATCHES DE COLOR --- */
QPushButton#swatchWhiteButton, QPushButton#swatchBlackButton, QPushButton#swatchGrayButton, QPushButton#swatchNoneButton, QPushButton#swatchCustomButton {
    padding: 0px;
    margin: 0px;
}
QPushButton#swatchWhiteButton { background-color: #FFFFFF; border: 1.5px solid #475569; border-radius: 8px; font-size: 14px; }
QPushButton#swatchBlackButton { background-color: #000000; border: 1.5px solid #475569; border-radius: 8px; font-size: 14px; }
QPushButton#swatchGrayButton { background-color: #64748B; border: 1.5px solid #94A3B8; border-radius: 8px; font-size: 14px; }
QPushButton#swatchNoneButton { background-color: #1E293B; border: 1.5px solid #334155; border-radius: 8px; font-size: 14px; color: #94A3B8; font-weight: bold; }
QPushButton#swatchCustomButton { background-color: #0F172A; border: 1.5px solid #334155; border-radius: 8px; font-size: 14px; }

QPushButton#swatchWhiteButton:checked, QPushButton#swatchBlackButton:checked, QPushButton#swatchGrayButton:checked, QPushButton#swatchCustomButton:checked, QPushButton#swatchNoneButton:checked {
    border: 2px solid #F43F5E;
}

/* --- INPUTS, SELECTORES Y DIÁLOGOS DE COLOR/ARCHIVO --- */
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #F8FAFC;
    font-size: 12px;
}
QComboBox {
    padding-right: 28px;
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #64748B;
}
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #F43F5E;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url({ASSETS_PATH}/chevron-down-dark.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox::down-arrow:hover {
    image: url({ASSETS_PATH}/chevron-down-hover.svg);
}
QComboBox QAbstractItemView {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 6px;
    selection-background-color: #3B1219;
    selection-color: #FB7185;
    color: #F8FAFC;
    padding: 4px;
}

QCheckBox {
    spacing: 8px;
    color: #E2E8F0;
    background: transparent;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #475569;
    background: #0F172A;
}
QCheckBox::indicator:hover {
    border-color: #F43F5E;
}
QCheckBox::indicator:checked {
    background-color: #F43F5E;
    border-color: #F43F5E;
}

/* --- ZONA DE ARRASTRE (LIENZO) --- */
QFrame#DropZone {
    background-color: #1E293B;
    border: 2px dashed #334155;
    border-radius: 16px;
}
QFrame#DropZone:hover {
    border-color: #F43F5E;
    background-color: #2A121B;
}
QLabel#DropZoneIcon {
    background-color: #3B1219;
    color: #FB7185;
    font-size: 24px;
    border-radius: 27px;
}
QLabel#DropZoneTitle {
    font-size: 16px;
    font-weight: 700;
    color: #F8FAFC;
    background: transparent;
}
QLabel#DropZoneSubtitle {
    color: #94A3B8;
    font-size: 13px;
    background: transparent;
}
QLabel#DropZoneFormats {
    color: #CBD5E1;
    font-size: 11px;
    background-color: #0F172A;
    border: 1px solid #334155;
    padding: 4px 10px;
    border-radius: 10px;
}

/* --- BARRA DE ESTADO INFERIOR Y PROGRESO --- */
QFrame#BottomBar, QWidget#statusBar {
    background-color: #1E293B;
    border-top: 1px solid #334155;
}
QLabel#statusText {
    color: #94A3B8;
    font-size: 12px;
    margin-left: 8px;
    background: transparent;
}
QLabel#imageInfoText {
    color: #CBD5E1;
    font-size: 11px;
    margin-left: 12px;
    background: transparent;
}
QProgressBar {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 6px;
    text-align: center;
    color: #F8FAFC;
    font-size: 11px;
    font-weight: 600;
    max-height: 16px;
}
QProgressBar::chunk {
    background-color: #F43F5E;
    border-radius: 5px;
}

/* --- SLIDERS --- */
QSlider {
    background: transparent;
}
QSlider::groove:horizontal {
    border: 1px solid #334155;
    height: 6px;
    background: #1E293B;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #F43F5E;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #F8FAFC;
    border: 2px solid #F43F5E;
    width: 14px;
    height: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border: 2px solid #FB7185;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: #0F172A;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #334155;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}
QScrollBar:horizontal {
    background: #0F172A;
    height: 12px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}

/* --- CONTROLES DE VENTANA FRAMELESS (macOS style) --- */
#macMinBtn {
    background-color: #FFBD2E;
    border: none;
    border-radius: 7px;
}
#macMinBtn:hover {
    background-color: #FFC950;
}
#macMaxBtn {
    background-color: #28C940;
    border: none;
    border-radius: 7px;
}
#macMaxBtn:hover {
    background-color: #31DB4A;
}
#macCloseBtn {
    background-color: #FF5F56;
    border: none;
    border-radius: 7px;
}
#macCloseBtn:hover {
    background-color: #FF746D;
}

/* --- DIÁLOGOS MODALES (ATAJOS, POPUPS FRAMELESS, QMESSAGEBOX) --- */
#shortcutsDialogRoot, #framelessPopupRoot {
    background-color: #1E293B;
    border-radius: 12px;
    border: 1px solid #334155;
}
#shortcutsDialogRoot QWidget, #framelessPopupRoot QWidget {
    background-color: transparent;
}
#shortcutsDialogTitle, #popupTitle {
    font-size: 14px;
    font-weight: 700;
    color: #F8FAFC;
    background: transparent;
}
#panelSeparator {
    background-color: #334155;
    border: none;
    max-height: 1px;
}
#shortcutsCategoryTitle {
    font-size: 11px;
    font-weight: 700;
    color: #FB7185;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
    background: transparent;
}
#statusShortcutsButton {
    background-color: #0F172A;
    color: #CBD5E1;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}
#statusShortcutsButton:hover {
    color: #FB7185;
    border-color: #F43F5E;
    background-color: #3B1219;
}
#shortcutBadge {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
}
#shortcutDesc {
    color: #94A3B8;
    font-size: 12px;
    background: transparent;
}
QMessageBox {
    background-color: #1E293B;
    color: #F8FAFC;
}
QMessageBox QLabel {
    color: #F8FAFC;
    background: transparent;
}

/* --- GROUPBOXES --- */
QGroupBox {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 3px 10px;
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}

/* --- BOTÓN DE PELIGRO (Eliminar selección) --- */
QPushButton#dangerActionButton {
    background-color: #EF4444;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton#dangerActionButton:hover {
    background-color: #DC2626;
}
QPushButton#dangerActionButton:pressed {
    background-color: #B91C1C;
}
QPushButton#dangerActionButton:disabled {
    background-color: #2A121B;
    color: #881337;
    border: 1px solid #3F1A26;
}

/* --- BARRA DE PAGINACIÓN GIF / VIDEO --- */
QFrame#gifPaginationBar {
    background-color: #1E293B;
    border-top: 1px solid #334155;
}
QPushButton#gifNavBtn {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 14px;
    padding: 0px;
    color: #E2E8F0;
}
QPushButton#gifNavBtn:hover {
    background-color: #334155;
    border-color: #475569;
}
QPushButton#gifNavBtn:disabled {
    background-color: #0F172A;
    border-color: #1E293B;
    color: #475569;
}
QPushButton#gifPlayBtn {
    background-color: #F43F5E;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    font-weight: 700;
    padding: 6px 14px;
}
QPushButton#gifPlayBtn:hover {
    background-color: #E11D48;
}
QLabel#gifPaginationLabel {
    color: #CBD5E1;
    font-weight: 600;
    font-size: 12px;
    background: transparent;
}
