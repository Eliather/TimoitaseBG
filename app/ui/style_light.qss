/* 
  TimoitaseBG - Hoja de estilos principal (Light Theme - Rediseño Moderno) 
*/

/* --- VENTANA PRINCIPAL Y FONDO GLOBAL --- */
QMainWindow {
    background-color: #F8FAFC;
}
QWidget {
    background-color: #F8FAFC;
    color: #1E293B;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    font-size: 13px;
}

/* --- BARRA SUPERIOR (TOP BAR) --- */
QFrame#TopBar, QWidget#topBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}
QLabel#AppTitle, QLabel#appNameLabel {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    background: transparent;
}
QLabel#appVersionBadge {
    background-color: #F1F5F9;
    color: #64748B;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

/* --- BOTONES GENERALES --- */
QPushButton {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    color: #334155;
}
QPushButton:hover {
    background-color: #E2E8F0;
    border-color: #CBD5E1;
}
QPushButton:pressed {
    background-color: #CBD5E1;
}
QPushButton:disabled {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    color: #94A3B8;
}

/* --- BOTÓN PRIMARIO (Coral / Rosa) --- */
QPushButton#PrimaryBtn, QPushButton#primaryBtn {
    background-color: #F43F5E;
    border: 1px solid #E11D48;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton#PrimaryBtn:hover, QPushButton#primaryBtn:hover {
    background-color: #E11D48;
}
QPushButton#PrimaryBtn:pressed, QPushButton#primaryBtn:pressed {
    background-color: #BE123C;
}
QPushButton#PrimaryBtn:disabled, QPushButton#primaryBtn:disabled {
    background-color: #FFE4E6;
    border-color: #FECDD3;
    color: #FB7185;
}

/* Compatibilidad actionButton */
QPushButton#actionButton {
    background-color: #F43F5E;
    border: 1px solid #E11D48;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton#actionButton:hover {
    background-color: #E11D48;
}
QPushButton#actionButton:disabled {
    background-color: #FFE4E6;
    border-color: #FECDD3;
    color: #FB7185;
}

/* --- BOTÓN DE ACCIÓN PRINCIPAL EN PANEL --- */
QPushButton#ActionBtn, QPushButton#primaryActionButton {
    background-color: #0F172A;
    border: none;
    color: #FFFFFF;
    padding: 10px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
}
QPushButton#ActionBtn:hover, QPushButton#primaryActionButton:hover {
    background-color: #1E293B;
}
QPushButton#ActionBtn:pressed, QPushButton#primaryActionButton:pressed {
    background-color: #334155;
}
QPushButton#ActionBtn:disabled, QPushButton#primaryActionButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

/* --- PESTAÑAS DE HERRAMIENTAS --- */
QPushButton#ToolTab, QPushButton#toolRailButton {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 4px;
    font-weight: 600;
    font-size: 12px;
    color: #475569;
}
QPushButton#ToolTab:hover, QPushButton#toolRailButton:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #0F172A;
}
QPushButton#ToolTab:checked, QPushButton#toolRailButton:checked {
    background-color: #FFF1F2;
    border: 1.5px solid #F43F5E;
    color: #E11D48;
}

/* --- PANEL LATERAL Y TARJETAS --- */
QFrame#SidePanel, QWidget#toolSidebar, QWidget#sidebar {
    background-color: #FFFFFF;
    border-left: 1px solid #E2E8F0;
}
QWidget#sidebar_header, QWidget#tool_tabs_row, QWidget#quick_shortcuts_box, QWidget#scroll_content, QWidget#toolsStack {
    background-color: transparent;
}
QFrame#Card, QGroupBox#Card {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}
QLabel#SectionTitle, QLabel#sidebarHeader {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
    background: transparent;
}
QLabel#SubTitle, QLabel#sidebarSubheader {
    font-size: 12px;
    color: #64748B;
    background: transparent;
}
QLabel#FieldLabel, QLabel#fieldLabel {
    font-weight: 600;
    color: #334155;
    font-size: 12px;
    background: transparent;
}

/* --- BOTONES DE ZOOM E HISTORIAL --- */
QPushButton#compactIconButton, QPushButton#zoomButton {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #334155;
}
QPushButton#compactIconButton:hover, QPushButton#zoomButton:hover {
    background-color: #E2E8F0;
    border-color: #CBD5E1;
}
QPushButton#compactIconButton:disabled, QPushButton#zoomButton:disabled {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    color: #94A3B8;
}

QPushButton#secondaryActionButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
}
QPushButton#secondaryActionButton:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #F43F5E;
}
QPushButton#secondaryActionButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* --- SWATCHES DE COLOR --- */
QPushButton#swatchWhiteButton, QPushButton#swatchBlackButton, QPushButton#swatchGrayButton, QPushButton#swatchNoneButton, QPushButton#swatchCustomButton {
    padding: 0px;
    margin: 0px;
}
QPushButton#swatchWhiteButton { background-color: #FFFFFF; border: 1.5px solid #CBD5E1; border-radius: 8px; font-size: 14px; }
QPushButton#swatchBlackButton { background-color: #000000; border: 1.5px solid #000000; border-radius: 8px; font-size: 14px; }
QPushButton#swatchGrayButton { background-color: #E2E8F0; border: 1.5px solid #CBD5E1; border-radius: 8px; font-size: 14px; }
QPushButton#swatchNoneButton { background-color: #FFFFFF; border: 1.5px solid #CBD5E1; border-radius: 8px; font-size: 14px; color: #64748B; font-weight: bold; }
QPushButton#swatchCustomButton { background-color: #F1F5F9; border: 1.5px solid #CBD5E1; border-radius: 8px; font-size: 14px; }

QPushButton#swatchWhiteButton:checked, QPushButton#swatchBlackButton:checked, QPushButton#swatchGrayButton:checked, QPushButton#swatchCustomButton:checked, QPushButton#swatchNoneButton:checked {
    border: 2px solid #F43F5E;
}

/* --- INPUTS Y SELECTORES --- */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 28px 6px 10px;
    color: #1E293B;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #94A3B8;
}
QComboBox:focus {
    border-color: #F43F5E;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url({ASSETS_PATH}/chevron-down-light.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox::down-arrow:hover {
    image: url({ASSETS_PATH}/chevron-down-hover.svg);
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    selection-background-color: #FFF1F2;
    selection-color: #E11D48;
    color: #1E293B;
    padding: 4px;
}

QCheckBox {
    spacing: 8px;
    color: #334155;
    background: transparent;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #CBD5E1;
    background: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #F43F5E;
}
QCheckBox::indicator:checked {
    background-color: #F43F5E;
    border-color: #F43F5E;
}

/* --- ZONA DE ARRASTRE (LIENZO) --- */
QFrame#DropZone {
    background-color: #FFFFFF;
    border: 2px dashed #CBD5E1;
    border-radius: 16px;
}
QFrame#DropZone:hover {
    border-color: #F43F5E;
    background-color: #FFF1F2;
}
QLabel#DropZoneIcon {
    background-color: #FFF1F2;
    color: #F43F5E;
    font-size: 24px;
    border-radius: 27px;
}
QLabel#DropZoneTitle {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
    background: transparent;
}
QLabel#DropZoneSubtitle {
    color: #64748B;
    font-size: 13px;
    background: transparent;
}
QLabel#DropZoneFormats {
    color: #94A3B8;
    font-size: 11px;
    background-color: #F8FAFC;
    padding: 4px 10px;
    border-radius: 10px;
}

/* --- BARRA DE ESTADO INFERIOR --- */
QFrame#BottomBar, QWidget#statusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    border: 1px solid #E2E8F0;
    height: 6px;
    background: #F1F5F9;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #F43F5E;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #94A3B8;
    width: 14px;
    height: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #F8FAFC;
    border: 1px solid #F43F5E;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: #F8FAFC;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- CONTROLES DE VENTANA FRAMELESS (macOS style) --- */
#macMinBtn {
    background-color: #FFBD2E;
    border-radius: 7px;
}
#macMinBtn:hover {
    background-color: #FFC950;
}
#macMaxBtn {
    background-color: #28C940;
    border-radius: 7px;
}
#macMaxBtn:hover {
    background-color: #31DB4A;
}
#macCloseBtn {
    background-color: #FF5F56;
    border-radius: 7px;
}
#macCloseBtn:hover {
    background-color: #FF746D;
}

/* --- DIÁLOGO MODAL DE ATAJOS --- */
#shortcutsDialogRoot {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #CBD5E1;
}
#shortcutsDialogTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1E293B;
}
#shortcutsCategoryTitle {
    font-size: 11px;
    font-weight: 700;
    color: #F43F5E;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
}
#statusShortcutsButton {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}
#statusShortcutsButton:hover {
    color: #E11D48;
    border-color: #FECDD3;
    background-color: #FFF1F2;
}
#shortcutBadge {
    background-color: #F1F5F9;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
}
#shortcutDesc {
    color: #475569;
    font-size: 12px;
}

/* --- GROUPBOXES --- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 3px 10px;
    background-color: #F1F5F9;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}

/* --- BOTÓN DE PELIGRO (Eliminar selección) --- */
QPushButton#dangerActionButton {
    background-color: #EF4444;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton#dangerActionButton:hover {
    background-color: #DC2626;
}
QPushButton#dangerActionButton:pressed {
    background-color: #B91C1C;
}
QPushButton#dangerActionButton:disabled {
    background-color: #FEE2E2;
    color: #FCA5A5;
    border: 1px solid #FECACA;
}

/* --- BARRA DE PAGINACIÓN GIF --- */
QFrame#gifPaginationBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}
QPushButton#gifNavBtn {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    font-size: 14px;
    padding: 0px;
    color: #1E293B;
}
QPushButton#gifNavBtn:hover {
    background-color: #E2E8F0;
    border-color: #CBD5E1;
}
QPushButton#gifPlayBtn {
    background-color: #F43F5E;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    font-weight: 700;
    padding: 6px 14px;
}
QPushButton#gifPlayBtn:hover {
    background-color: #E11D48;
}
QLabel#gifPaginationLabel {
    color: #64748B;
    font-weight: 600;
    font-size: 12px;
}

