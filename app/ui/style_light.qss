/* 
  TimoitaseBG - Hoja de estilos principal (Light Theme) 
*/

/* --- FONDO GLOBAL Y TEXTO --- */
QWidget {
    background-color: #F8FAFC;
    color: #1E293B;
    font-family: 'Segoe UI', 'San Francisco', 'Inter', sans-serif;
    font-size: 13px;
}

/* --- BARRA LATERAL (TOOLBAR) --- */
QWidget#toolSidebar, QWidget#sidebar {
    background-color: #F8FAFC;
    border-left: 1px solid #E2E8F0;
}

QWidget#sidebar_header, QWidget#tool_tabs_row, QWidget#quick_shortcuts_box, QWidget#scroll_content, QWidget#toolsStack {
    background-color: transparent;
}

QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

QLabel#sidebarHeader {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
    background: transparent;
}

QLabel#sidebarSubheader {
    font-size: 12px;
    color: #64748B;
    background: transparent;
}

/* --- BOTONES PRINCIPALES --- */
QPushButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:checked {
    background-color: #FFF0F4;
    color: #E11D48;
    border: 1px solid #FF4F79;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border: 1px solid #E2E8F0;
}

/* --- BOTÓN DE ACCIÓN DESTACADO --- */
QPushButton#actionButton {
    background-color: #FF4F79;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
}
QPushButton#actionButton:hover {
    background-color: #FF3B6B;
}
QPushButton#actionButton:disabled {
    background-color: #FFE4E6;
    color: #FDA4AF;
}

/* --- BOTONES DE HERRAMIENTA Y ZOOM --- */
QPushButton#toolRailButton {
    padding: 6px 2px;
    font-size: 12px;
}
QPushButton#compactIconButton, QPushButton#zoomButton {
    padding: 4px;
    font-size: 14px;
}

/* --- SWATCHES Y PRESETS --- */
QPushButton#presetButton {
    padding: 2px 4px;
    font-size: 11px;
}
QPushButton#brushToolModeButton {
    padding: 4px 8px;
}
QPushButton#selectionModeButton {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    padding: 2px 8px;
}
QPushButton#selectionModeButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
    color: #0F172A;
}
QPushButton#selectionModeButton:checked {
    background-color: #2563EB;
    border: 1px solid #1D4ED8;
    color: #FFFFFF;
}

QPushButton#dangerActionButton {
    background-color: #EF4444;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton#dangerActionButton:hover {
    background-color: #DC2626;
}
QPushButton#dangerActionButton:pressed {
    background-color: #B91C1C;
}
QPushButton#dangerActionButton:disabled {
    background-color: #FEE2E2;
    color: #FCA5A5;
    border: 1px solid #FECACA;
}
QPushButton#swatchWhiteButton { background-color: #FFFFFF; border: 1px solid #D6D3D1; padding: 0px; }
QPushButton#swatchBlackButton { background-color: #000000; border: 1px solid #3D3D3D; padding: 0px; }
QPushButton#swatchGrayButton { background-color: #E2E8F0; border: 1px solid #D6D3D1; padding: 0px; }
QPushButton#swatchNoneButton, QPushButton#swatchCustomButton { padding: 0px; }

QPushButton#swatchWhiteButton:checked, QPushButton#swatchBlackButton:checked, QPushButton#swatchGrayButton:checked, QPushButton#swatchCustomButton:checked, QPushButton#swatchNoneButton:checked {
    border: 2px solid #FF4F79;
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    border: 1px solid #E2E8F0;
    height: 6px;
    background: #F1F5F9;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #FF4F79;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #94A3B8;
    width: 14px;
    height: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #F8FAFC;
    border: 1px solid #FF4F79;
}

/* --- COMBOBOX --- */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 5px 28px 5px 10px;
    color: #1E293B;
    font-size: 12px;
}
QComboBox:hover {
    border: 1px solid #FF4F79;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url({ASSETS_PATH}/chevron-down-light.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox::down-arrow:hover {
    image: url({ASSETS_PATH}/chevron-down-hover.svg);
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    selection-background-color: #FFF0F4;
    selection-color: #FF4F79;
    color: #1E293B;
    padding: 4px;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: #F8FAFC;
    width: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- TABS --- */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background: #F8FAFC;
    color: #64748B;
    border: 1px solid #E2E8F0;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1E293B;
    border-bottom-color: #FFFFFF;
}
QTabBar::tab:hover:!selected {
    background: #F1F5F9;
    color: #334155;
}

/* --- CHECKBOXES --- */
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background: #FF4F79;
    border: 1px solid #E11D48;
}
QCheckBox::indicator:hover {
    border: 1px solid #FF4F79;
}

/* --- WINDOW CONTROLS (Frameless macOS style) --- */
#macMinBtn {
    background-color: #FFBD2E;
    border-radius: 7px;
}
#macMinBtn:hover {
    background-color: #FFC950;
}
#macMaxBtn {
    background-color: #28C940;
    border-radius: 7px;
}
#macMaxBtn:hover {
    background-color: #31DB4A;
}
#macCloseBtn {
    background-color: #FF5F56;
    border-radius: 7px;
}
#macCloseBtn:hover {
    background-color: #FF746D;
}

/* --- KO-FI BUTTON --- */
#kofiButton {
    background-color: #FF5E5B;
    color: white;
    font-weight: bold;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
}
#kofiButton:hover {
    background-color: #FF7775;
}

/* --- FRAMELESS POPUP --- */
#framelessPopupRoot {
    background-color: #FFFFFF;
    border-radius: 10px;
    border: 1px solid #E2E8F0;
}
#popupTitle {
    font-weight: bold;
    color: #6B7280;
}

/* --- GROUPBOXES Y ETIQUETAS DE SECCIÓN CON FONDO DETRÁS DEL TEXTO --- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 3px 10px;
    background-color: #F1F5F9;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}

QGroupBox#wandOptionsBox::title {
    background-color: #FFE4EC;
    color: #E11D48;
    border: 1px solid #FECDD3;
}

QGroupBox#selectionBox::title {
    background-color: #EFF6FF;
    color: #1D4ED8;
    border: 1px solid #BFDBFE;
}

/* --- SHORTCUTS MODAL DIALOG --- */
#shortcutsDialogRoot {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #CBD5E1;
}
#shortcutsDialogTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1E293B;
}
#shortcutsCategoryTitle {
    font-size: 11px;
    font-weight: 700;
    color: #FF4F79;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
}
#statusShortcutsButton {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
#statusShortcutsButton:hover {
    color: #FF4F79;
    border-color: #FF4F79;
    background-color: #FFF0F4;
}
#statusShortcutsButton:pressed {
    background-color: #FFE4EC;
}
#shortcutBadge {
    background-color: #F1F5F9;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
}
#shortcutDesc {
    color: #475569;
    font-size: 12px;
}

